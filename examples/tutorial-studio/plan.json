{
  "$schema": "../../packages/core/schema/scene-plan.schema.json",
  "version": 1,
  "projectId": "tutorial-dalang-studio",
  "meta": {
    "title": "Cara Membuat Video di Dalang Studio",
    "aspectRatio": "16:9",
    "language": "id",
    "stylePreset": "tutorial-01"
  },
  "audio": {
    "voice": {
      "provider": "silence",
      "voiceId": "id-default",
      "speed": 1
    }
  },
  "scenes": [
    {
      "id": "sc-title",
      "narration": "Dari satu brief menjadi video jadi — semua di satu studio.",
      "visual": {
        "type": "template-anim",
        "variant": "title"
      },
      "duration": 4.2,
      "caption": {
        "enabled": false
      },
      "transition": {
        "type": "cross-fade"
      }
    },
    {
      "id": "sc-step-1",
      "narration": "Mulai dari kartu brief: isi topik, gaya, durasi, dan rasio, lalu klik Susun scene-plan.",
      "visual": {
        "type": "screenshot",
        "assetId": "assets/step-1-brief.png"
      },
      "transition": {
        "type": "slide-left"
      },
      "annotations": [
        {
          "type": "zoom",
          "target": {
            "x": 0.009,
            "y": 0.117,
            "w": 0.192,
            "h": 0.502
          },
          "timing": {
            "startSec": 1.1
          }
        },
        {
          "type": "highlight",
          "target": {
            "x": 0.019,
            "y": 0.564,
            "w": 0.171,
            "h": 0.036
          },
          "timing": {
            "startSec": 3.4
          }
        }
      ]
    },
    {
      "id": "sc-step-2",
      "narration": "Agent menyusun scene-plan; timeline, preview, dan properti langsung terisi — semuanya tetap bisa kamu edit.",
      "visual": {
        "type": "screenshot",
        "assetId": "assets/step-2-editor.png"
      },
      "transition": {
        "type": "slide-left"
      },
      "annotations": [
        {
          "type": "highlight",
          "target": {
            "x": 0.0,
            "y": 0.809,
            "w": 1.0,
            "h": 0.191
          },
          "timing": {
            "startSec": 1.2,
            "endSec": 4.2
          }
        },
        {
          "type": "zoom",
          "target": {
            "x": 0.21,
            "y": 0.75,
            "w": 0.4,
            "h": 0.22
          },
          "timing": {
            "startSec": 4.4
          }
        },
        {
          "type": "blur",
          "target": {
            "x": 0.883,
            "y": 0.012,
            "w": 0.045,
            "h": 0.033
          },
          "timing": {
            "startSec": 0
          }
        }
      ]
    },
    {
      "id": "sc-step-3",
      "narration": "Kalau sudah pas, klik Ekspor dan pilih profil: Draft untuk cek cepat, Final untuk rilis.",
      "visual": {
        "type": "screenshot",
        "assetId": "assets/step-3-export.png"
      },
      "transition": {
        "type": "cross-fade"
      },
      "annotations": [
        {
          "type": "zoom",
          "target": {
            "x": 0.366,
            "y": 0.312,
            "w": 0.269,
            "h": 0.376
          },
          "timing": {
            "startSec": 0.9
          }
        },
        {
          "type": "highlight",
          "target": {
            "x": 0.38,
            "y": 0.429,
            "w": 0.24,
            "h": 0.087
          },
          "timing": {
            "startSec": 2.4,
            "endSec": 4.6
          }
        },
        {
          "type": "arrow",
          "target": {
            "x": 0.556,
            "y": 0.63,
            "w": 0.064,
            "h": 0.034
          },
          "timing": {
            "startSec": 4.6
          }
        }
      ],
      "layers": [
        {
          "id": "lap-brief",
          "visual": {
            "type": "screenshot",
            "assetId": "assets/step-1-brief.png",
            "pinned": true,
            "motion": "none"
          },
          "anchor": "kanan-bawah",
          "width": 0.3,
          "height": 0.26,
          "offsetX": 0.0,
          "offsetY": -0.1,
          "shape": "persegi",
          "radius": 0.06,
          "border": 0.004,
          "opacity": 1,
          "fit": "cover",
          "entrance": "geser",
          "startFrac": 0.18,
          "endFrac": 0.82
        }
      ]
    },
    {
      "id": "sc-outro",
      "narration": "Satu brief, satu video. Selamat mencoba.",
      "visual": {
        "type": "template-anim",
        "variant": "outro"
      },
      "duration": 3.6,
      "caption": {
        "enabled": false
      },
      "transition": {
        "type": "none"
      }
    }
  ],
  "renderState": {
    "narrationAudio": {},
    "resolvedAssets": {
      "sc-step-1": {
        "file": "assets/step-1-brief.png",
        "kind": "image",
        "source": "local",
        "license": "Tangkapan layar Dalang Studio (aset proyek sendiri)",
        "width": 3200,
        "height": 1800
      },
      "sc-step-2": {
        "file": "assets/step-2-editor.png",
        "kind": "image",
        "source": "local",
        "license": "Tangkapan layar Dalang Studio (aset proyek sendiri)",
        "width": 3200,
        "height": 1800
      },
      "sc-step-3": {
        "file": "assets/step-3-export.png",
        "kind": "image",
        "source": "local",
        "license": "Tangkapan layar Dalang Studio (aset proyek sendiri)",
        "width": 3200,
        "height": 1800
      }
    },
    "layerAssets": {
      "lap-brief": {
        "file": "assets/step-1-brief.png",
        "kind": "image",
        "source": "local",
        "license": "Tangkapan layar Dalang Studio (aset proyek sendiri)",
        "width": 3200,
        "height": 1800
      }
    }
  }
}
