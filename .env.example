# Salin ke .env (gitignored). Semua opsional — pipeline berjalan offline
# dengan provider "silence" tanpa key apa pun.

# ── Agent (Fase 2) ──────────────────────────────────────────────────────────
# Model LLM via Vercel AI SDK; default: anthropic/claude-opus-5 (orkestrator)
# dan anthropic/claude-haiku-4-5 (tier volume: riset/vision).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# DALANG_MODEL=anthropic/claude-opus-5
# DALANG_MODEL_VOLUME=anthropic/claude-haiku-4-5
# Provider OpenAI-compatible kustom (mis. gateway lokal):
# DALANG_OPENAI_COMPAT_BASE_URL=
# DALANG_OPENAI_COMPAT_API_KEY=

# TTS utama (PRD §4.2). Wajib bila plan memakai provider "elevenlabs".
ELEVENLABS_API_KEY=
# Opsional; default eleven_multilingual_v2 (mendukung Bahasa Indonesia).
ELEVENLABS_MODEL_ID=

# Stock assets — minimal satu agar `dalang generate` bisa me-resolve scene "stock".
PEXELS_API_KEY=
PIXABAY_API_KEY=
