# Salin ke .env (gitignored). Semua opsional — pipeline berjalan offline
# dengan provider "silence" tanpa key apa pun.

# ── Model LLM (agent, Fase 2+) — NETRAL VENDOR ─────────────────────────────
# Dalang tidak memihak provider. Pasang API key provider pilihanmu (satu
# saja), dan model default dipilih dari registry models.dev untuk provider
# itu. Bila lebih dari satu key terpasang, atau mau model tertentu, set
# eksplisit DALANG_MODEL (dan opsional DALANG_MODEL_VOLUME untuk tier
# riset/vision yang murah).
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# Gateway OpenAI-compatible (Ollama, LM Studio, OpenRouter, vLLM, dsb.):
# DALANG_OPENAI_COMPAT_BASE_URL=
# DALANG_OPENAI_COMPAT_API_KEY=
# Pilihan eksplisit (format provider/model-id):
# DALANG_MODEL=
# DALANG_MODEL_VOLUME=

# ── TTS (PRD §4.2) ─────────────────────────────────────────────────────────
# Wajib bila plan memakai provider "elevenlabs".
ELEVENLABS_API_KEY=
# Opsional; default eleven_multilingual_v2 (mendukung Bahasa Indonesia).
ELEVENLABS_MODEL_ID=

# ── Stock assets ───────────────────────────────────────────────────────────
# Minimal satu agar `dalang generate` bisa me-resolve scene "stock".
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Render cloud, opsional (ADR-0019, PRD Fase 5) ──────────────────────────
# Tanpa ini `dalang render` tetap berjalan penuh di mesin sendiri. Isi hanya
# bila ingin `dalang render --target lambda`. Nilai-nilai ini milik AKUN AWS-mu,
# jadi tempatnya di sini, bukan di scene-plan yang ikut ter-commit dan dibagikan.
#
# Penyiapan sekali di akun AWS-mu:
#   npx remotion lambda functions deploy
#   npx remotion lambda sites create packages/templates/src/index.ts --site-name=dalang
# lalu jalankan `dalang cloud:check` untuk memastikan semuanya terbaca.
# AWS_REGION=
# DALANG_LAMBDA_FUNCTION=
# DALANG_LAMBDA_BUCKET=
# DALANG_LAMBDA_SERVE_URL=
# Opsional; default 2048 MB dan 20 frame per invokasi.
# DALANG_LAMBDA_MEMORY_MB=
# DALANG_LAMBDA_FRAMES_PER_LAMBDA=

# ── Publikasi langsung, opsional (ADR-0030, roadmap §10.3) ─────────────────
# `dalang publish` dan tombol "Unggah ke YouTube" di Studio memakai token akses
# OAuth 2.0 milik AKUN GOOGLE-MU dengan cakupan youtube.upload — mis. dari
# https://developers.google.com/oauthplayground (pilih YouTube Data API v3 →
# https://www.googleapis.com/auth/youtube.upload). Token akses kedaluwarsa
# (biasanya 1 jam); Dalang tidak menyegarkannya dan akan mengatakannya bila
# ditolak. Bawaan unggahan PRIVAT.
# YOUTUBE_ACCESS_TOKEN=
