# Konfigurasi Dalang. DIBANGKITKAN dari katalog; jangan disunting tangan.
# Perbarui dengan: pnpm env:gen   (tes menolak bila berkas ini basi)
#
# Cara termudah: jalankan `pnpm dalang setup`. Ia memindai apa yang sudah
# ada di mesinmu, menanyakan sisanya dengan bahasa biasa, menguji tiap
# kunci ke layanannya, lalu menulis .env untukmu. Yang tidak memakai
# terminal bisa memakai bagian Pengaturan di lobi Studio.
#
# SEMUA baris di bawah opsional. Tanpa satu kunci pun, Dalang tetap
# menyusun, merender, dan mengekspor video: suara memakai Edge TTS gratis
# atau trek hening berdurasi tepat, dan aset memakai berkasmu sendiri.
#
# Simpan salinanmu sebagai .env di folder ini. Berkas .env tidak pernah
# ikut ter-commit, dan Dalang tidak pernah mencetak isi kunci ke layar.

# ── Bikin video lewat percakapan ──────────────────────────────────────────
# Kamu menulis maunya dengan kalimat biasa, dan agent yang menyusun naskah,
# memilih aset, lalu merapikan timeline.
# Tanpa ini: Studio dan CLI tetap berfungsi penuh untuk mengedit sendiri;
# panel chat mengatakan kunci apa yang kurang.
# Cukup SATU dari yang bertanda WAJIB.
#
# [WAJIB] Kunci API Anthropic
#   Menyalakan chat agent dengan model Claude.
#   1. Buka console.anthropic.com lalu masuk atau daftar.
#   2. Masuk ke API Keys, buat kunci baru, salin.
#   3. Perlu saldo terisi; pemakaian dibayar per token.
#   contoh: sk-ant-...
# ANTHROPIC_API_KEY=
#
# [WAJIB] Kunci API Google AI
#   Menyalakan chat agent dengan model Gemini.
#   1. Buka aistudio.google.com/apikey lalu masuk dengan akun Google.
#   2. Klik Create API key, salin.
#   3. Ada kuota gratis yang cukup untuk mencoba.
#   contoh: AIza...
# GOOGLE_GENERATIVE_AI_API_KEY=
#
# [WAJIB] Kunci API OpenAI
#   Menyalakan chat agent dengan model GPT.
#   1. Buka platform.openai.com/api-keys lalu masuk.
#   2. Klik Create new secret key, salin.
#   3. Perlu saldo terisi; pemakaian dibayar per token.
#   contoh: sk-...
# OPENAI_API_KEY=
#
# [WAJIB] Alamat gateway OpenAI-compatible
#   Memakai model dari Ollama, LM Studio, OpenRouter, vLLM, atau gateway
#   lain yang bicara protokol OpenAI. Bisa sepenuhnya lokal dan gratis.
#   1. Ollama: pasang dari ollama.com, jalankan ollama serve, alamatnya
#   http://localhost:11434/v1.
#   2. LM Studio: nyalakan server lokalnya, alamatnya
#   http://localhost:1234/v1.
#   3. OpenRouter dan sejenisnya: pakai alamat yang tertulis di
#   dokumentasinya, lalu isi juga kunci di bawah.
#   contoh: http://localhost:11434/v1
# DALANG_OPENAI_COMPAT_BASE_URL=
#
# [opsional] Kunci gateway OpenAI-compatible
#   Kunci untuk gateway di atas.
#   bila kosong: Kosongkan untuk server lokal seperti Ollama yang tidak
#   memakai kunci.
# DALANG_OPENAI_COMPAT_API_KEY=
#
# [opsional] Model orkestrator pilihanmu
#   Memilih model tertentu alih-alih membiarkan Dalang memilihkan. Isi kalau
#   kamu memasang lebih dari satu kunci, atau mau model yang spesifik.
#   contoh: anthropic/claude-sonnet-4-5
#   bila kosong: Dipilih otomatis dari registry models.dev sesuai kunci yang
#   terpasang.
# DALANG_MODEL=
#
# [opsional] Model tier murah untuk riset dan penglihatan
#   Dipakai untuk pekerjaan bervolume: riset naskah dan meninjau frame
#   render. Model kecil yang murah cocok di sini.
#   contoh: google/gemini-2.5-flash
#   bila kosong: Memakai model orkestrator, atau tool terkait mengatakan
#   tidak tersedia.
# DALANG_MODEL_VOLUME=

# ── Suara narator yang terdengar manusia ──────────────────────────────────
# Narasi dibacakan dengan suara sintetis berkualitas tinggi, lengkap dengan
# penanda waktu per kata untuk caption.
# Tanpa ini: Tetap ada suara: Edge TTS gratis tanpa kunci, dan provider
# silence membuat trek hening berdurasi tepat supaya timing video tetap
# benar.
#
# [WAJIB] Kunci API ElevenLabs
#   Menyalakan suara ElevenLabs, termasuk Bahasa Indonesia, dengan penanda
#   waktu per kata dari providernya sendiri.
#   1. Buka elevenlabs.io lalu masuk atau daftar (ada paket gratis).
#   2. Klik foto profil di kanan atas, pilih API Keys.
#   3. Buat kunci baru, salin, lalu tempel di sini.
#   contoh: sk_...
# ELEVENLABS_API_KEY=
#
# [opsional] Model suara ElevenLabs
#   Memilih model suara tertentu.
#   contoh: eleven_multilingual_v2
#   bila kosong: eleven_multilingual_v2, yang mendukung Bahasa Indonesia.
# ELEVENLABS_MODEL_ID=

# ── Cari video dan foto stok otomatis ─────────────────────────────────────
# Scene bertipe stok mengambil footage yang cocok dari pustaka berlisensi
# jelas, lalu menyimpannya ke folder proyek.
# Tanpa ini: Scene stok tidak bisa di-resolve. Kamu tetap bisa memakai
# gambar dan rekaman sendiri, template animasi, dan warna solid.
# Cukup SATU dari yang bertanda WAJIB.
#
# [WAJIB] Kunci API Pexels
#   Video dan foto gratis dengan lisensi yang boleh dipakai komersial.
#   1. Buka pexels.com/api lalu masuk atau daftar.
#   2. Klik Get Started, isi nama proyek seadanya.
#   3. Salin kunci yang muncul. Gratis, tanpa kartu kredit.
# PEXELS_API_KEY=
#
# [WAJIB] Kunci API Pixabay
#   Pustaka kedua, dipakai sebagai cadangan bila Pexels tidak menemukan.
#   1. Buka pixabay.com/api/docs lalu masuk atau daftar.
#   2. Kuncinya langsung tampil di halaman itu setelah masuk.
#   3. Gratis, tanpa kartu kredit.
# PIXABAY_API_KEY=

# ── Ubah rekaman jadi teks berwaktu ───────────────────────────────────────
# Rekaman panjang ditranskrip per kata, sehingga bisa dipotong berdasarkan
# kalimat dan dijadikan caption otomatis.
# Tanpa ini: Rekaman tetap bisa dipasang dan dipotong dengan tangan; caption
# ditulis sendiri.
# Jalan lain: whisper.cpp terpasang di PATH beserta modelnya, yang membuat
# rekaman tidak pernah keluar dari mesinmu
#
# [opsional] Lokasi program whisper.cpp
#   Transkripsi berjalan sepenuhnya di mesinmu, gratis, tanpa mengirim
#   rekaman ke siapa pun.
#   1. Pasang whisper.cpp, mis. dengan brew install whisper-cpp di macOS.
#   2. Unduh satu berkas model, mis. ggml-base.bin dari
#   huggingface.co/ggerganov/whisper.cpp.
#   3. Isi baris ini hanya bila programnya tidak ada di PATH; kalau ada,
#   Dalang menemukannya sendiri.
#   contoh: /usr/local/bin/whisper-cli
#   bila kosong: Dicari otomatis di PATH.
# WHISPER_CPP_BIN=
#
# [opsional] Berkas model whisper.cpp
#   Model yang dipakai transkripsi lokal.
#   contoh: ~/models/ggml-base.bin
#   bila kosong: Dicari otomatis di folder model yang lazim.
# WHISPER_CPP_MODEL=
#
# [WAJIB] Kunci API Deepgram
#   Transkripsi lewat layanan Deepgram, cepat dan akurat. Rekaman dikirim ke
#   server mereka.
#   1. Buka console.deepgram.com lalu daftar.
#   2. Buat API key di menu API Keys, salin.
#   3. Ada saldo gratis awal untuk mencoba.
# DEEPGRAM_API_KEY=
#
# [opsional] Model Deepgram
#   Memilih model pengenalan suara tertentu.
#   contoh: nova-3
#   bila kosong: Bawaan provider.
# DEEPGRAM_MODEL=

# ── Stiker dan GIF beranimasi ─────────────────────────────────────────────
# Menempelkan stiker beralfa dan GIF ke scene, untuk klip yang lebih hidup.
# Tanpa ini: Ikon dari Iconify tetap tersedia tanpa kunci apa pun, dan bisa
# diwarnai sendiri.
# Cukup SATU dari yang bertanda WAJIB.
#
# [WAJIB] Kunci API GIPHY
#   Pencarian stiker dan GIF GIPHY. Isinya unggahan orang lain, jadi hak
#   pakainya perlu kamu periksa sebelum dipublikasikan.
#   1. Buka developers.giphy.com lalu daftar.
#   2. Klik Create an App, pilih API, salin kuncinya.
# GIPHY_API_KEY=
#
# [WAJIB] Kunci API Tenor
#   Pustaka stiker kedua, dengan peringatan hak pakai yang sama.
#   1. Buka developers.google.com/tenor lalu ikuti langkah membuat kunci di
#   Google Cloud.
# TENOR_API_KEY=

# ── Efek suara ────────────────────────────────────────────────────────────
# Menambahkan efek suara berlisensi terbuka ke scene.
# Tanpa ini: Sudah jalan tanpa apa pun. Token di bawah hanya menaikkan batas
# laju.
#
# [opsional] Token Openverse
#   Menaikkan batas jumlah pencarian per jam. Openverse tetap bisa dipakai
#   tanpa ini.
#   1. Daftar di api.openverse.org lewat menu Register.
#   bila kosong: Tanpa token, dengan batas laju yang lebih rendah.
# OPENVERSE_TOKEN=

# ── Unggah langsung ke YouTube ────────────────────────────────────────────
# Hasil render diunggah dari Studio atau CLI, dengan judul dan deskripsi
# yang sudah diturunkan dari plan.
# Tanpa ini: Berkas hasil render tetap ada di folder proyek dan bisa
# diunggah sendiri lewat browser.
#
# [WAJIB] Token akses YouTube
#   Menyalakan tombol Unggah. Bawaan unggahan selalu privat, dan setiap
#   unggahan minta konfirmasi.
#   1. Buka developers.google.com/oauthplayground.
#   2. Di daftar kiri pilih YouTube Data API v3, centang cakupan
#   .../auth/youtube.upload.
#   3. Klik Authorize APIs, masuk dengan akun YouTube-mu, lalu Exchange
#   authorization code for tokens.
#   4. Salin Access token. Token ini biasanya kedaluwarsa dalam satu jam dan
#   harus diambil ulang.
#   contoh: ya29....
# YOUTUBE_ACCESS_TOKEN=

# ── Render di cloud, bukan di laptop ──────────────────────────────────────
# Render dikerjakan AWS Lambda secara paralel, jadi video panjang selesai
# jauh lebih cepat.
# Tanpa ini: Render tetap berjalan penuh di mesin ini. Untuk kebanyakan
# orang ini sudah cukup.
# SEMUA yang bertanda WAJIB harus diisi.
#
# [WAJIB] Region AWS
#   Region tempat fungsi dan bucket render berada.
#   contoh: ap-southeast-1
# AWS_REGION=
#
# [WAJIB] AWS Access Key ID
#   Kredensial AWS. Dibaca oleh SDK AWS, bukan oleh Dalang sendiri, jadi
#   profil AWS yang sudah terpasang di mesinmu juga berlaku.
#   1. Buat IAM user di konsol AWS dengan izin sesuai dokumentasi Remotion
#   Lambda.
#   2. Boleh dikosongkan bila kamu sudah memakai aws configure atau profil
#   SSO.
# AWS_ACCESS_KEY_ID=
#
# [WAJIB] AWS Secret Access Key
#   Pasangan dari kunci di atas.
# AWS_SECRET_ACCESS_KEY=
#
# [WAJIB] Nama fungsi Lambda
#   Fungsi render yang sudah kamu pasang di akun AWS-mu.
#   1. Jalankan npx remotion lambda functions deploy, lalu salin namanya.
#   contoh: remotion-render-4-0-0-mem2048mb-disk2048mb-120sec
# DALANG_LAMBDA_FUNCTION=
#
# [WAJIB] Bucket S3
#   Tempat hasil render disimpan sebelum diunduh.
#   contoh: remotionlambda-apsoutheast1-abc123
# DALANG_LAMBDA_BUCKET=
#
# [WAJIB] Serve URL situs Remotion
#   Bundel template yang dipakai Lambda saat merender.
#   1. Jalankan npx remotion lambda sites create
#   packages/templates/src/index.ts --site-name=dalang, lalu salin URL-nya.
# DALANG_LAMBDA_SERVE_URL=
#
# [opsional] Memori per invokasi
#   Menaikkannya mempercepat render, dan menaikkan biaya per detik.
#   bila kosong: 2048
# DALANG_LAMBDA_MEMORY_MB=
#
# [opsional] Frame per invokasi
#   Semakin kecil, semakin banyak invokasi paralel.
#   bila kosong: 20
# DALANG_LAMBDA_FRAMES_PER_LAMBDA=

# ── Setelan lanjutan ──────────────────────────────────────────────────────
# Jarang perlu diubah. Ada di sini supaya tidak perlu membaca kode untuk
# menemukannya.
# Tanpa ini: Semua punya bawaan yang masuk akal.
#
# [opsional] Folder rumah Dalang
#   Tempat memori preferensi lintas proyek disimpan. Berguna bila satu akun
#   OS dipakai dua orang.
#   bila kosong: ~/.dalang
# DALANG_HOME=
#
# [opsional] Folder cache
#   Tempat bundel render dan snapshot registry model di-cache.
#   bila kosong: ~/.cache/dalang
# DALANG_CACHE_DIR=
#
# [opsional] Batas ukuran unggahan rekaman
#   Batas berkas yang boleh diunggah lewat panel sumber di Studio.
#   bila kosong: 4096
# DALANG_MAX_UPLOAD_MB=
#
# [opsional] Lokasi Chromium untuk render
#   Dipakai bila Dalang tidak menemukan peramban sendiri, mis. di server
#   tanpa antarmuka.
#   bila kosong: Dicari otomatis, termasuk Chrome Headless Shell milik
#   Remotion.
# REMOTION_BROWSER_EXECUTABLE=
#
# [opsional] Lokasi Chromium alternatif
#   Dibaca sebagai cadangan bila baris di atas kosong.
#   bila kosong: Sama seperti di atas.
# PUPPETEER_EXECUTABLE_PATH=
#
# [opsional] Folder peramban Playwright
#   Folder tempat Playwright menaruh peramban; ikut dicari saat Dalang butuh
#   Chromium.
#   bila kosong: /opt/pw-browsers
# PLAYWRIGHT_BROWSERS_PATH=
