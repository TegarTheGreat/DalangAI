# Salin ke .env (gitignored). Semua opsional — pipeline berjalan offline
# dengan provider "silence" tanpa key apa pun.

# ── Model LLM (agent, Fase 2+) — NETRAL VENDOR ─────────────────────────────
# Dalang tidak memihak provider. Pasang API key provider pilihanmu (satu
# saja), dan model default dipilih dari registry models.dev untuk provider
# itu. Bila lebih dari satu key terpasang, atau mau model tertentu, set
# eksplisit DALANG_MODEL (dan opsional DALANG_MODEL_VOLUME untuk tier
# riset/vision yang murah).
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# Gateway OpenAI-compatible (Ollama, LM Studio, OpenRouter, vLLM, dsb.):
# DALANG_OPENAI_COMPAT_BASE_URL=
# DALANG_OPENAI_COMPAT_API_KEY=
# Pilihan eksplisit (format provider/model-id):
# DALANG_MODEL=
# DALANG_MODEL_VOLUME=

# ── TTS (PRD §4.2) ─────────────────────────────────────────────────────────
# Wajib bila plan memakai provider "elevenlabs".
ELEVENLABS_API_KEY=
# Opsional; default eleven_multilingual_v2 (mendukung Bahasa Indonesia).
ELEVENLABS_MODEL_ID=

# ── Stock assets ───────────────────────────────────────────────────────────
# Minimal satu agar `dalang generate` bisa me-resolve scene "stock".
PEXELS_API_KEY=
PIXABAY_API_KEY=
