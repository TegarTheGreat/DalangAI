{
  "name": "dalang",
  "private": true,
  "version": "0.1.0",
  "description": "Dalang AI \u2014 platform video editor berpilot agent (agent-piloted video editor)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dalang": "tsx packages/cli/src/main.ts",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "schema:gen": "tsx packages/core/scripts/generate-schema.ts",
    "studio:remotion": "pnpm --filter @dalang/templates studio",
    "env:gen": "tsx packages/providers/scripts/generate-env-example.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "undici@>=7.0.0 <7.29.1": "7.30.0",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "ip-address@<=10.7.0": "10.7.3",
      "hono@<4.13.7": "4.13.12"
    }
  }
}
