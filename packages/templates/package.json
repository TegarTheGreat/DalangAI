{
  "name": "@dalang/templates",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Curated Remotion style presets \u2014 the visual language of Dalang videos",
  "exports": {
    ".": "./src/index.ts",
    "./video": "./src/DalangVideo.tsx",
    "./paths": "./src/paths.ts",
    "./layout": "./src/layout.ts",
    "./review-frames": "./src/review-frames.ts",
    "./fonts": "./src/fonts.ts",
    "./music": "./src/music.ts",
    "./subtitle": "./src/subtitle.ts"
  },
  "scripts": {
    "gate:subtitle": "tsx scripts/subtitle-gate.mts",
    "gate:sulih": "tsx scripts/sulih-gate.mts",
    "stage-demo": "node scripts/stage-demo.mjs",
    "studio": "node scripts/stage-demo.mjs && remotion studio src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@dalang/core": "workspace:*",
    "@remotion/captions": "4.0.518",
    "@remotion/fonts": "4.0.518",
    "@remotion/layout-utils": "4.0.518",
    "@remotion/media": "4.0.518",
    "@remotion/transitions": "4.0.518",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.518",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
