{
  "name": "@dalang/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local render target: bundles Remotion templates and renders scene-plans to video/stills",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
