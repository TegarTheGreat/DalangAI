  },
  "dependencies": {
    "@dalang/core": "workspace:*",
    "@dalang/pipeline": "workspace:*",
    "@dalang/templates": "workspace:*",
    "@remotion/bundler": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
