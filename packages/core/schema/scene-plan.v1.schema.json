{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "aspectRatio": {
          "default": "9:16",
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "1:1"
          ]
        },
        "targetDuration": {
          "default": "auto",
          "anyOf": [
            {
              "type": "string",
              "const": "auto"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "language": {
          "default": "id",
          "type": "string"
        },
        "stylePreset": {
          "default": "documentary-01",
          "type": "string"
        },
        "tokens": {
          "type": "object",
          "properties": {
            "primary": {
              "type": "string"
            },
            "accent": {
              "type": "string"
            },
            "fontDisplay": {
              "type": "string"
            },
            "fontBody": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "audio": {
      "default": {},
      "type": "object",
      "properties": {
        "voice": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "voiceId": {
              "type": "string",
              "minLength": 1
            },
            "speed": {
              "default": 1,
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "provider",
            "voiceId"
          ],
          "additionalProperties": false
        },
        "music": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "minLength": 1
            },
            "volume": {
              "default": 0.15,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ducking": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "assetId"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locked": {
            "default": false,
            "type": "boolean"
          },
          "narration": {
            "default": "",
            "type": "string"
          },
          "visual": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stock",
                  "image",
                  "generated",
                  "screenshot",
                  "solid",
                  "template-anim"
                ]
              },
              "query": {
                "type": "string"
              },
              "assetId": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "motion": {
                "default": "none",
                "type": "string",
                "enum": [
                  "none",
                  "kenburns-in",
                  "kenburns-out",
                  "pan-left",
                  "pan-right"
                ]
              },
              "pinned": {
                "default": false,
                "type": "boolean"
              },
              "variant": {
                "type": "string"
              },
              "filter": {
                "type": "object",
                "properties": {
                  "preset": {
                    "default": "none",
                    "type": "string",
                    "enum": [
                      "none",
                      "warm",
                      "cool",
                      "mono",
                      "vivid",
                      "film"
                    ]
                  },
                  "brightness": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 2
                  },
                  "contrast": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 2
                  },
                  "saturation": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2
                  },
                  "opacity": {
                    "default": 1,
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "caption": {
            "default": {
              "enabled": true,
              "style": "inherit"
            },
            "type": "object",
            "properties": {
              "enabled": {
                "default": true,
                "type": "boolean"
              },
              "style": {
                "default": "inherit",
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "duration": {
            "default": "auto",
            "anyOf": [
              {
                "type": "string",
                "const": "auto"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ]
          },
          "transition": {
            "default": {
              "type": "cross-fade",
              "durationFrames": 15
            },
            "type": "object",
            "properties": {
              "type": {
                "default": "cross-fade",
                "type": "string",
                "enum": [
                  "cross-fade",
                  "slide-left",
                  "slide-right",
                  "slide-up",
                  "wipe-right",
                  "wipe-down",
                  "none"
                ]
              },
              "durationFrames": {
                "default": 15,
                "type": "integer",
                "minimum": 6,
                "maximum": 24
              }
            },
            "additionalProperties": false
          },
          "texts": {
            "default": [],
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "default": "headline",
                  "type": "string",
                  "enum": [
                    "headline",
                    "subline",
                    "kicker",
                    "quote"
                  ]
                },
                "position": {
                  "default": "center",
                  "type": "string",
                  "enum": [
                    "top",
                    "center",
                    "bottom"
                  ]
                },
                "align": {
                  "default": "center",
                  "type": "string",
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "size": {
                  "default": "m",
                  "type": "string",
                  "enum": [
                    "s",
                    "m",
                    "l"
                  ]
                },
                "emphasis": {
                  "default": "none",
                  "type": "string",
                  "enum": [
                    "none",
                    "box",
                    "underline"
                  ]
                },
                "startFrac": {
                  "default": 0,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "endFrac": {
                  "default": 1,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "annotations": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "zoom",
                    "highlight",
                    "arrow",
                    "blur"
                  ]
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "w": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "h": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "w",
                    "h"
                  ],
                  "additionalProperties": false
                },
                "timing": {
                  "type": "object",
                  "properties": {
                    "startSec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endSec": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "startSec"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type",
                "target",
                "timing"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "visual"
        ],
        "additionalProperties": false
      }
    },
    "renderState": {
      "default": {
        "narrationAudio": {},
        "resolvedAssets": {}
      },
      "type": "object",
      "properties": {
        "narrationAudio": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "durationSec": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "wordTimestamps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "word": {
                      "type": "string"
                    },
                    "startSec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endSec": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "word",
                    "startSec",
                    "endSec"
                  ],
                  "additionalProperties": false
                }
              },
              "fallbackQuality": {
                "type": "boolean"
              }
            },
            "required": [
              "file",
              "durationSec"
            ],
            "additionalProperties": false
          }
        },
        "resolvedAssets": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "image",
                  "video",
                  "audio"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "sourceUrl": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "file",
              "kind",
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "projectId",
    "meta",
    "scenes"
  ],
  "additionalProperties": false,
  "title": "Dalang Scene-Plan v1",
  "description": "Single source of truth sebuah video Dalang (PRD §5.1). Divalidasi runtime oleh @dalang/core (zod)."
}
